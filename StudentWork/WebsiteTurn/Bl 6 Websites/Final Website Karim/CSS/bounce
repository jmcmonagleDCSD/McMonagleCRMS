body {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
    background-color: #f0f0f0;
}


.bounce-element {
    width: 100px;
    height: 100px;
    background: #00bfff;
    border-radius: 50%; 
    position: relative; 
    animation: bounce 2s infinite; 
}


@keyframes bounce {
    0%, 100% {
        top: 0; 
        animation-timing-function: ease-in; 
    }
    50% {
        top: -100px;
        animation-timing-function: ease-out; 
    }
}